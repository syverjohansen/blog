{
  "schema_version": 1,
  "description": "Ownership and modernization status for every Nordic Numbers JSON artifact family referenced by a live Hugo layout.",
  "states": {
    "modernized": "Generated and validated by an active hosted workflow.",
    "legacy_gap": "A legacy artifact exists, but no active hosted workflow owns its regeneration."
  },
  "milestones": {
    "phase_2_alpine_cross_country_site_parity": {
      "status": "complete",
      "sports": ["alpine", "cross-country"],
      "requirement": "Every live artifact family is generated, tested, and published by its active daily workflow."
    },
    "phase_5_ski_jumping_site_parity": {
      "status": "complete",
      "sports": ["skijump"],
      "requirement": "Every live ski-jumping artifact family is generated, tested, rendered, and published after accepted results."
    },
    "phase_6_nordic_combined_site_parity": {
      "status": "complete",
      "sports": ["nordic-combined"],
      "requirement": "Every live Nordic Combined artifact family is generated, tested, rendered, and published after accepted results."
    }
  },
  "owners": {
    "alpine_site_data": {
      "state": "modernized",
      "workflow": ".github/workflows/alpine-site-data-update.yml",
      "generator": "pipelines/alpine_site_data.py",
      "cadence": "daily after accepted Alpine data changes",
      "source": "validated Alpine histories, completed-season standings, and accepted team/event inputs from the pinned ski revision"
    },
    "cross_country_site_data": {
      "state": "modernized",
      "workflow": ".github/workflows/cross-country-site-data-update.yml",
      "generator": "pipelines/cross_country_site_data.py",
      "cadence": "daily after accepted cross-country data changes",
      "source": "validated cross-country histories, completed-season standings, and accepted relay/team-sprint inputs from the pinned ski revision"
    },
    "skijump_site_data": {
      "state": "modernized",
      "workflow": ".github/workflows/ski-jumping-site-data-update.yml",
      "generator": "pipelines/skijump_site_data.py",
      "cadence": "after every successful accepted ski-jumping results run",
      "source": "validated individual and member-level team histories plus ranking history from the pinned ski revision"
    },
    "nordic_combined_site_data": {
      "state": "modernized",
      "workflow": ".github/workflows/nordic-combined-site-data-update.yml",
      "generator": "pipelines/nordic_combined_site_data.py",
      "cadence": "after every successful accepted Nordic Combined results run",
      "source": "validated individual and member-level team histories plus ranking history from the pinned ski revision"
    },
    "retired_master_automation": {
      "state": "legacy_gap",
      "workflow": null,
      "generator": null,
      "cadence": "not running",
      "source": "legacy mutable local ski checkout"
    }
  },
  "families": {
    "current_elo": {
      "reference_glob": "*_chrono_current.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/elo_tables.py"
    },
    "all_time_elo": {
      "reference_glob": "*_chrono_all_time.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/all_time_elo.py"
    },
    "athlete_ids": {
      "reference_glob": "*_all_ids.json",
      "format": "json",
      "shape": "object<athlete_id,name>",
      "legacy_generator": "static/python/{sport}/all_ids.py"
    },
    "skier_lookup": {
      "reference_glob": "*_skiers_lookup.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/skier_tables.py"
    },
    "skier_groups": {
      "reference_glob": "*/skiers_*.json",
      "format": "json",
      "shape": "object<athlete_id,history>",
      "legacy_generator": "static/python/{sport}/skier_tables.py"
    },
    "skier_info": {
      "reference_glob": "*/skier_info.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/skier_info.py"
    },
    "rankings": {
      "reference_glob": "*/ranks.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/ranks.py"
    },
    "season_index": {
      "reference_glob": "*/seasons.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/races.py"
    },
    "race_summary": {
      "reference_glob": "*/*/summary.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/races.py"
    },
    "race_results": {
      "reference_glob": "*/*/race_*.json",
      "format": "json",
      "shape": "array<object>",
      "legacy_generator": "static/python/{sport}/races.py"
    },
    "head_to_head": {
      "reference_glob": "head2head/*_*.json",
      "format": "json",
      "shape": "object keyed by athlete_id or season_race",
      "legacy_generator": "static/python/{sport}/head2head.py"
    },
    "athlete_history_updates": {
      "reference_glob": "*_athlete_history_updates.json",
      "format": "json",
      "shape": "object<athlete_id,history_overlay>",
      "legacy_generator": null
    }
  },
  "sports": {
    "alpine": {
      "artifact_root": "static/python/alpine/excel365",
      "coverage": {
        "current_elo": {"owner": "alpine_site_data"},
        "all_time_elo": {"owner": "alpine_site_data"},
        "athlete_ids": {"owner": "alpine_site_data"},
        "skier_lookup": {"owner": "alpine_site_data"},
        "skier_groups": {"owner": "alpine_site_data"},
        "skier_info": {"owner": "alpine_site_data"},
        "rankings": {"owner": "alpine_site_data"},
        "season_index": {"owner": "alpine_site_data"},
        "race_summary": {"owner": "alpine_site_data"},
        "race_results": {"owner": "alpine_site_data"},
        "head_to_head": {"owner": "alpine_site_data"},
        "athlete_history_updates": {"owner": "alpine_site_data"}
      }
    },
    "cross-country": {
      "artifact_root": "static/python/cross-country/excel365",
      "coverage": {
        "current_elo": {"owner": "cross_country_site_data"},
        "all_time_elo": {"owner": "cross_country_site_data"},
        "athlete_ids": {"owner": "cross_country_site_data"},
        "skier_lookup": {"owner": "cross_country_site_data"},
        "skier_groups": {"owner": "cross_country_site_data"},
        "skier_info": {"owner": "cross_country_site_data"},
        "rankings": {"owner": "cross_country_site_data"},
        "season_index": {"owner": "cross_country_site_data"},
        "race_summary": {"owner": "cross_country_site_data"},
        "race_results": {"owner": "cross_country_site_data"},
        "head_to_head": {"owner": "cross_country_site_data"},
        "athlete_history_updates": {
          "owner": "cross_country_site_data",
          "repository_materialization": "pending_first_accepted_change"
        }
      }
    },
    "skijump": {
      "artifact_root": "static/python/skijump/excel365",
      "coverage": {
        "current_elo": {"owner": "skijump_site_data"},
        "all_time_elo": {"owner": "skijump_site_data"},
        "athlete_ids": {"owner": "skijump_site_data"},
        "skier_lookup": {"owner": "skijump_site_data"},
        "skier_groups": {"owner": "skijump_site_data"},
        "skier_info": {"owner": "skijump_site_data"},
        "rankings": {"owner": "skijump_site_data"},
        "season_index": {"owner": "skijump_site_data"},
        "race_summary": {"owner": "skijump_site_data"},
        "race_results": {"owner": "skijump_site_data"},
        "head_to_head": {"owner": "skijump_site_data"}
      }
    },
    "nordic-combined": {
      "artifact_root": "static/python/nordic-combined/excel365",
      "coverage": {
        "current_elo": {"owner": "nordic_combined_site_data"},
        "all_time_elo": {"owner": "nordic_combined_site_data"},
        "athlete_ids": {"owner": "nordic_combined_site_data"},
        "skier_lookup": {"owner": "nordic_combined_site_data"},
        "skier_groups": {"owner": "nordic_combined_site_data"},
        "skier_info": {"owner": "nordic_combined_site_data"},
        "rankings": {"owner": "nordic_combined_site_data"},
        "season_index": {"owner": "nordic_combined_site_data"},
        "race_summary": {"owner": "nordic_combined_site_data"},
        "race_results": {"owner": "nordic_combined_site_data"},
        "head_to_head": {"owner": "nordic_combined_site_data"}
      }
    },
    "biathlon": {
      "artifact_root": "static/python/biathlon/excel365",
      "coverage": {
        "current_elo": {"owner": "retired_master_automation", "target_phase": 7},
        "all_time_elo": {"owner": "retired_master_automation", "target_phase": 7},
        "athlete_ids": {"owner": "retired_master_automation", "target_phase": 7},
        "skier_lookup": {"owner": "retired_master_automation", "target_phase": 7},
        "skier_groups": {"owner": "retired_master_automation", "target_phase": 7},
        "skier_info": {"owner": "retired_master_automation", "target_phase": 7},
        "rankings": {"owner": "retired_master_automation", "target_phase": 7},
        "season_index": {"owner": "retired_master_automation", "target_phase": 7},
        "race_summary": {"owner": "retired_master_automation", "target_phase": 7},
        "race_results": {"owner": "retired_master_automation", "target_phase": 7},
        "head_to_head": {"owner": "retired_master_automation", "target_phase": 7}
      }
    }
  }
}
